{
  "name": "wizardgang-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static software engineering portfolio for Jacob Yongue at wizardgang.ai.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "check:frontend": "npm run typecheck && npm run build && node scripts/verify-react-shell.mjs",
    "check": "npm run check:frontend && node scripts/verify.mjs",
    "test:dev": "node --test tests/dev-lifecycle.test.mjs",
    "secrets:cloudflare:discover": "bash scripts/discover-cloudflare-api-token-targets.sh",
    "secrets:cloudflare:rotate": "bash scripts/rotate-cloudflare-api-token.sh",
    "dev": "node scripts/dev.mjs",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "deploy:staging:dry-run": "npm run build && wrangler deploy --dry-run --env staging",
    "deploy:production:dry-run": "npm run build && wrangler deploy --dry-run --env production",
    "test:browser": "node --test tests/browser-behavior.test.mjs",
    "test:projects": "node --test tests/project-surfaces.test.mjs",
    "test:work": "node --test tests/work-surfaces.test.mjs",
    "test:pages": "node --test tests/page-authority.test.mjs",
    "test:frontend-authority": "node --test tests/frontend-authority.test.mjs",
    "test:navigation": "node --test tests/navigation-authority.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.127.1"
  }
}
